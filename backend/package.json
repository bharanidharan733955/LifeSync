{
  "name": "lifetrack-backend",
  "version": "1.0.0",
  "description": "LifeTrack Backend API - Personal Finance, Diet & Nutrition Management Platform",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .js",
    "seed": "node src/utils/seed.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "lifetrack",
    "finance",
    "nutrition",
    "diet",
    "mern",
    "api"
  ],
  "author": "LifeTrack Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "mongodbMemoryServer": {
    "downloadDir": "./.cache/mongodb-binaries",
    "version": "7.0.14"
  }
