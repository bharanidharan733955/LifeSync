# ────────────────────────────────────────────────────────────────────────────────
# LIFETRACK BACKEND – ENVIRONMENT VARIABLES
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ── MongoDB ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lifetrack?retryWrites=true&w=majority
# Local fallback for development
# MONGODB_URI=mongodb://127.0.0.1:27017/lifetrack

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=<generate-with-openssl-rand-base64-64>
JWT_REFRESH_SECRET=<generate-with-openssl-rand-base64-64>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=LifeTrack <noreply@lifetrack.app>

# ── Frontend URL (for CORS & email links) ─────────────────────────────────────
FRONTEND_URL=http://localhost:5173
MOBILE_DEEP_LINK_SCHEME=lifetrack

# ── AI Provider ──────────────────────────────────────────────────────────────
# Supports Google Gemini or OpenAI-compatible endpoints
AI_PROVIDER=gemini
AI_API_KEY=<your-ai-api-key>
AI_MODEL=gemini-1.5-flash
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7

# ── Open Food Facts ──────────────────────────────────────────────────────────
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_USER_AGENT=LifeTrack/1.0 (contact@lifetrack.app)

# ── File Storage ─────────────────────────────────────────────────────────────
# Options: local | s3 | cloudinary
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads
# For S3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=lifetrack-uploads
# For Cloudinary:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── Cookie ───────────────────────────────────────────────────────────────────
COOKIE_SECRET=<generate-with-openssl-rand-base64-32>

# ── Swagger ──────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

