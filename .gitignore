# ─────────────────────────────────────────────────────────────────────────────
# LifeTrack Monorepo .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
!.env.test.example

# Production & Build Artifacts
dist/
dist-ssr/
build/
web-build/
out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
*.lcov
.nyc_output/
.vitest/

# Cache directories
.cache/
.eslintcache
.parcel-cache
.turbo/

# Backend uploads, reports & binaries
backend/uploads/*
!backend/uploads/.gitkeep
backend/reports/*
!backend/reports/.gitkeep
backend/temp/
.cache/mongodb-binaries/

# Expo & Mobile
.expo/
.metro/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Editor & OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE & Tooling
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

